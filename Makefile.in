GUILE = @GUILE@
GUILD = @abs_top_builddir@/etc/guild
INSTALL = $(TOPDIR)/etc/install-sh -m 644

GUILE_LOAD_PATH = @GUILE_LOAD_PATH@
GUILE_LOAD_COMPILED_PATH = @GUILE_LOAD_COMPILED_PATH@

GUILE_TARGET = @GUILE_TARGET@

SITE_SCM_DIR = @GUILE_GLOBAL_SITE@
SITE_SCM_GO_DIR = @GUILE_SITE_CCACHE@

INFODIR = @GUILE_DATA@/info
HTMLDIR = @GUILE_DATA@/doc/guile-cdata

VPATH = @abs_top_srcdir@/module
TOPDIR = @abs_top_srcdir@
SCMDIR = @abs_top_srcdir@
GODIR = @abs_top_builddir@

SOURCES = foreign/arch-info.scm foreign/cdata.scm
BINARIES = foreign/arch-info.go foreign/cdata.go

# execute tests in the test-suite subdir
TESTENV = GUILE_LOAD_PATH= GUILE_LOAD_COMPILED_PATH= GUILE_AUTO_COMPILE=0 \
		$(GUILE) -L $(SCMDIR) -C $(GODIR) 2>/dev/null
TESTS = arch-info-01.test cdata-01.test cdata-02.test

%.go: %.scm
	GUILE_LOAD_PATH=$(SCMDIR):$(GUILE_LOAD_PATH) \
	GUILE_LOAD_COMPILED_PATH=$(GODIR):$(GUILE_LOAD_COMPILED_PATH) \
	  $(GUILD) compile $(GUILE_TARGET) -o $@ $<

.PHONY: default
default: $(BINARIES)
	@true

.PHONY: check
check:
	@(RES="ALL PASS"; export RES; \
	  cp $(TOPDIR)/test-suite/chkarch.c .; \
	  for test in $(TESTS); do \
	    $(TESTENV) $(TOPDIR)/test-suite/$${test}; \
	    if test $$? -ne 0; then RES="SOMETHING FAILED"; fi; \
	done; echo $$RES)

.PHONY: install
install: install-srcs install-bins install-info install-html
	@true

.PHONY: uninstall
uninstall: uninstall-srcs uninstall-bins uninstall-info uninstall-html
	@true

.PHONY: install-srcs
install-srcs:
	@mkdir -p $(DESTDIR)$(SITE_SCM_DIR)/foreign
	@echo "installing sources in $(DESTDIR)$(SITE_SCM_DIR)/foreign"
	@for file in $(SOURCES); do \
	  $(INSTALL) $(SCMDIR)/module/$${file} $(DESTDIR)$(SITE_SCM_DIR)/$${file}; \
	done

.PHONY: uninstall-srcs
uninstall-srcs:
	@echo uninstalling cdata sources
	@for file in $(SOURCES); do \
	  rm -f $(DESTDIR)$(SITE_SCM_DIR)/$${file}; \
	done

.PHONY: install-bins
install-bins: $(BINARIES)
	@mkdir -p $(DESTDIR)$(SITE_SCM_GO_DIR)/foreign
	@echo "installing binaries in $(DESTDIR)$(SITE_SCM_GO_DIR)/foreign"
	@for file in $(BINARIES); do \
	  $(INSTALL) $(GODIR)/$${file} $(DESTDIR)$(SITE_SCM_GO_DIR)/$${file}; \
	done

.PHONY: uninstall-bins
uninstall-bins:
	@echo uninstalling cdata binaries
	@for file in $(BINARIES); do \
	  rm -f $(DESTDIR)$(SITE_SCM_GO_DIR)/$${file}; \
	done

.PHONY: install-info
install-info:
	@echo "installing cdata.info in $(DESTDIR)$(INFODIR)"
	@mkdir -p $(DESTDIR)$(INFODIR)
	@$(INSTALL) $(TOPDIR)/doc/cdata.info $(DESTDIR)$(INFODIR)

.PHONY: uninstall-info
uninstall-info:
	@echo uninstalling cdata info file
	@rm -f $(DESTDIR)$(INFODIR)/cdata.info

.PHONY: install-html
install-html:
	@echo "installing cdata.html in $(DESTDIR)$(INFODIR)"
	@mkdir -p $(DESTDIR)$(HTMLDIR)
	@$(INSTALL) $(TOPDIR)/doc/cdata.html $(DESTDIR)$(HTMLDIR)

.PHONY: uninstall-html
uninstall-html: 
	@echo uninstalling cdata html file
	@rm -f $(DESTDIR)$(HTMLDIR)/cdata.html

.PHONY: clean
clean:
	rm -f foreign/*.go

.PHONY: dist-clean
distclean:
	rm -f Makefile config.log config.status

.PHONY: dist-hook
dist-hook:

.NOTPARALLEL:

# --- last line ---
